PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX leptum: <https://mpeters.dev/ns/leptum#>

# Mirrors RoutineCompletion (lib/remoteStorage.ts) as written by
# routineCompletionToRdf and read by extractRoutineCompletion.
leptum:RoutineCompletionShape EXTRA a {
  a [ schema:CompleteAction ] ;
  schema:object IRI ? ;
  schema:name xsd:string ? ;
  schema:endTime xsd:dateTime ? ;
  leptum:routineInstanceId xsd:string ? ;
  leptum:taskCount xsd:decimal ?
}
